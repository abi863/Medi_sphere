# ============================================================
# MEDISPHERE COGNITIVE TWIN - ENVIRONMENT CONFIGURATION
# ============================================================
# Do NOT commit production secrets. Copy this file to .env and configure.

# Database Storage (MongoDB / HIPAA Vault Concept)
MONGODB_URI=mongodb://admin:placeholderSecret@localhost:27017/medisphere?authSource=admin
MONGODB_DATABASE=medisphere
MONGODB_ENABLED=true

# Apache Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# FHIR Interoperability & SMART on FHIR
FHIR_BASE_URL=http://localhost:8081/fhir
FHIR_CLIENT_ID=medisphere-client
FHIR_CLIENT_SECRET=placeholder-client-secret-change-in-prod
FHIR_AUTHORIZE_URL=http://localhost:8081/oauth/authorize
FHIR_TOKEN_URL=http://localhost:8081/oauth/token

# Clinical Authentication & Security
JWT_SECRET=ReplaceWithSecure256BitOrHigherCryptographicSecretKey2026
DEMO_MODE=true

# TensorFlow Federated AI/ML Service
AI_SERVICE_URL=http://localhost:5000
